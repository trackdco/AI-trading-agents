//@version=6
// ============================================================================
//  NQ ARMED EMPIRE  -  8-level book + session-VWAP book + NY-VWAP book
//  Port of the frozen mechanical spec (docs/SPEC-va-book-clean-room.md plus the
//  VWAP and 8-level books from the engine). Chart: NQ1! or MNQ1!, 1-MINUTE,
//  regular session data (not extended-hours-off). Timezone is forced to New York.
//
//  Known differences from the Python engine (all small, all disclosed):
//   * Entry fills one tick THROUGH the level, like the engine, but at the
//     through price (level -/+ 0.25) instead of the level itself.
//   * SAR and end-of-day flats fill at the NEXT bar's open, not the signal
//     candle's close.
//   * A bar that touches both stop and target: the engine scores STOP; the
//     TradingView emulator guesses from the bar shape.
//   * Two books filling the same minute in the same direction within 5pt are
//     both taken here (engine drops the second).
//   * Roll days are not skipped. Weekly levels need at least one Monday 18:00
//     on the chart. The news list below ends 2026-07-16: add new dates.
// ============================================================================
strategy("NQ Armed Empire", shorttitle="Armed Empire", overlay=true, pyramiding=3,
     default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=100000,
     currency=currency.USD, commission_type=strategy.commission.cash_per_contract,
     commission_value=5.0, max_lines_count=500, max_labels_count=500)
// commission 5.0 = $5 per contract per side = $10 round trip = 0.5pt on NQ.
// On MNQ set it to 0.5 to keep the same 0.5pt cost.

// ---------------------------------------------------------------- inputs ----
TZ        = "America/New_York"
TICK      = 0.25
depthPts  = input.float(3.0,  "Displacement: close through level (pts)", step=0.25)
armR      = input.float(1.0,  "Arming: run past level before limit is live (R)", step=0.25)
floorPts  = input.float(5.0,  "Stop floor (pts)", step=0.25)
capPts    = input.float(30.0, "Stop cap (pts) - signal skipped above", step=1.0)
tgtR      = input.float(1.0,  "Target (R)", step=0.25)
useBook8  = input.bool(true,  "Book 1: 8 levels (PD VAH/VAL/POC/High/Low + weekly VAH/VAL/POC)")
useBookVS = input.bool(true,  "Book 2: session VWAP +/-1,2 sigma (18:00 anchor)")
useBookVN = input.bool(true,  "Book 3: NY VWAP +/-1,2 sigma (09:30 anchor)")
useNews   = input.bool(true,  "News gate: no entries 08:00-09:30 on red-folder days")
newsDays  = input.string("20230106,20230112,20230118,20230126,20230127,20230203,20230214,20230215,20230224,20230310,20230314,20230315,20230331,20230407,20230412,20230414,20230427,20230428,20230505,20230510,20230516,20230526,20230602,20230613,20230615,20230630,20230707,20230712,20230718,20230727,20230728,20230804,20230810,20230815,20230831,20230901,20230913,20230914,20230929,20231006,20231012,20231017,20231026,20231027,20231103,20231114,20231115,20231130,20231208,20231212,20231214,20231222,20240105,20240111,20240117,20240125,20240126,20240202,20240213,20240215,20240229,20240308,20240312,20240314,20240329,20240405,20240410,20240415,20240425,20240426,20240503,20240515,20240531,20240607,20240612,20240618,20240628,20240705,20240711,20240716,20240725,20240726,20240802,20240814,20240815,20240830,20240906,20240911,20240917,20240927,20241004,20241010,20241017,20241030,20241031,20241101,20241113,20241115,20241206,20241211,20241217,20241220,20250110,20250115,20250116,20250130,20250131,20250207,20250212,20250214,20250228,20250307,20250312,20250317,20250328,20250404,20250410,20250416,20250430,20250502,20250513,20250515,20250530,20250606,20250611,20250617,20250627,20250703,20250715,20250717,20250730,20250731,20250801,20250812,20250815,20250829,20250905,20250911,20250916,20250926,20251024,20251120,20251125,20251216,20251218,20260109,20260113,20260114,20260210,20260211,20260213,20260220,20260306,20260311,20260313,20260401,20260403,20260409,20260410,20260421,20260430,20260508,20260512,20260514,20260528,20260605,20260610,20260617,20260625,20260702,20260714,20260716", "Red-folder days YYYYMMDD, comma list")
showLv    = input.bool(true,  "Draw the 8 levels")

if not timeframe.isintraday or timeframe.multiplier != 1
    runtime.error("Armed Empire must run on a 1-minute chart.")

// ------------------------------------------------------------ session clock ----
hr      = hour(time, TZ)
mn      = minute(time, TZ)
mos     = (hr * 60 + mn - 1080 + 1440) % 1440        // minutes since 18:00 ET
newSess = na(mos[1]) or mos < mos[1]
dkey    = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
isNewsDay = useNews and str.contains(newsDays, str.tostring(dkey))
inBlock   = isNewsDay and mos >= 840 and mos < 930   // 08:00 <= t < 09:30

// ----------------------------------------------------------------- helpers ----
round025(float x) => math.round(x / TICK) * TICK

addBar(map<int, float> m) =>
    b0 = int(math.floor(low))
    b1 = int(math.floor(high))
    v  = volume / (b1 - b0 + 1)
    for b = b0 to b1
        m.put(b, nz(m.get(b)) + v)

// volume profile: 1pt bins, POC = max bin (lowest on tie), VA expands two bins
// at a time from the POC (ties go up) until it holds 70% of volume.
profile(map<int, float> m) =>
    float poc = na
    float val = na
    float vah = na
    keys = map.keys(m)
    if keys.size() > 0
        int bmin = int(array.min(keys))
        int bmax = int(array.max(keys))
        n = bmax - bmin + 1
        rows = array.new<float>(n, 0.0)
        for k in keys
            rows.set(k - bmin, m.get(k))
        total = rows.sum()
        if total > 0
            int i  = rows.indexof(rows.max())
            int lo = i
            int hi = i
            float cum = rows.get(i)
            while cum < 0.7 * total and (lo > 0 or hi < n - 1)
                float up = hi < n - 1 ? rows.get(hi + 1) + (hi + 2 <= n - 1 ? rows.get(hi + 2) : 0.0) : -1.0
                float dn = lo > 0 ? rows.get(lo - 1) + (lo - 2 >= 0 ? rows.get(lo - 2) : 0.0) : -1.0
                if up >= dn and hi < n - 1
                    hi := math.min(hi + 2, n - 1)
                else if lo > 0
                    lo := math.max(lo - 2, 0)
                else
                    break
                cum := 0.0
                for j = lo to hi
                    cum += rows.get(j)
            poc := (bmin + i) * 1.0
            val := (bmin + lo) * 1.0
            vah := (bmin + hi + 1) * 1.0
    [poc, val, vah]

// structural stop: one tick past the signal candle; if the candle opened within
// the floor of the level, use the prior candle too; never inside the floor.
stopFor(int d, float L) =>
    usePrev = math.abs(open - L) < floorPts
    float st = na
    if d == 1
        ref = usePrev ? math.min(low, low[1]) : low
        st := ref - TICK
        if L - st < floorPts
            st := L - floorPts
    else
        ref = usePrev ? math.max(high, high[1]) : high
        st := ref + TICK
        if st - L < floorPts
            st := L + floorPts
    st

addLv(array<float> px, array<int> pr, float v, int r) =>
    if not na(v)
        px.push(round025(v))
        pr.push(r)

isOpenId(string id) =>
    bool r = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                r := true
    r

closedThisBar(string id) =>
    bool r = false
    if strategy.closedtrades > 0
        k = strategy.closedtrades - 1
        if strategy.closedtrades.entry_id(k) == id and strategy.closedtrades.exit_bar_index(k) == bar_index
            r := true
    r

// ----------------------------------------------------- level construction ----
var pdMap  = map.new<int, float>()
var wkMap  = map.new<int, float>()
var int   pdBars = 0
var float sessHi = na
var float sessLo = na
var float pdPOC = na
var float pdVAL = na
var float pdVAH = na
var float pdH   = na
var float pdL   = na
var lv8 = array.new<float>()          // merged 8-level book for the day
var bool book8Active = false

if newSess
    // finish the prior session
    [p, vl, vh] = profile(pdMap)
    pdPOC := pdBars >= 300 ? p  : na
    pdVAL := pdBars >= 300 ? vl : na
    pdVAH := pdBars >= 300 ? vh : na
    pdH   := pdBars >= 300 ? sessHi : na
    pdL   := pdBars >= 300 ? sessLo : na
    pdMap.clear()
    pdBars := 0
    sessHi := high
    sessLo := low
    book8Active := false
    lv8.clear()
    if dayofweek(time, TZ) == dayofweek.monday
        wkMap.clear()                 // weekly profile anchors to Monday 18:00
else
    sessHi := math.max(sessHi, high)
    sessLo := math.min(sessLo, low)

// weekly levels are read at 19:00 (developing profile up to, not including, this bar)
if mos == 60 and useBook8 and not na(pdVAH) and not na(pdVAL)
    [wp, wvl, wvh] = profile(wkMap)
    // families in priority order: VA, weekly VA, PD high/low, POC, weekly POC
    px = array.new<float>()
    pr = array.new<int>()
    addLv(px, pr, pdVAH, 0)
    addLv(px, pr, pdVAL, 0)
    addLv(px, pr, wvh, 1)
    addLv(px, pr, wvl, 1)
    addLv(px, pr, pdH, 2)
    addLv(px, pr, pdL, 2)
    addLv(px, pr, pdPOC, 3)
    addLv(px, pr, wp, 4)
    // proximity merge: any two levels within one floor of each other, the
    // weaker family drops; repeat until none are that close
    bool changed = true
    while changed and px.size() > 1
        changed := false
        // sort by price (parallel arrays, tiny n)
        for a = 0 to px.size() - 2
            for c = 0 to px.size() - 2 - a
                if px.get(c) > px.get(c + 1)
                    swapP = px.get(c)
                    px.set(c, px.get(c + 1))
                    px.set(c + 1, swapP)
                    swapR = pr.get(c)
                    pr.set(c, pr.get(c + 1))
                    pr.set(c + 1, swapR)
        for c = 0 to px.size() - 2
            if px.get(c + 1) - px.get(c) <= floorPts
                drop = pr.get(c) > pr.get(c + 1) ? c : c + 1
                px.remove(drop)
                pr.remove(drop)
                changed := true
                break
    lv8 := px
    book8Active := px.size() > 0
    if showLv and px.size() > 0
        tEnd = time + 22 * 60 * 60 * 1000
        for c = 0 to px.size() - 1
            line.new(time, px.get(c), tEnd, px.get(c), xloc=xloc.bar_time, color=color.new(color.orange, 30), width=1)

addBar(pdMap)
addBar(wkMap)
pdBars += 1

// ------------------------------------------------------------- VWAP books ----
var float pvS = 0.0
var float vvS = 0.0
var float p2S = 0.0
var float pvN = 0.0
var float vvN = 0.0
var float p2N = 0.0
if newSess
    pvS := 0.0
    vvS := 0.0
    p2S := 0.0
if mos == 930
    pvN := 0.0
    vvN := 0.0
    p2N := 0.0
tp = hlc3
pvS += tp * volume
vvS += volume
p2S += tp * tp * volume
vwS = vvS > 0 ? pvS / vvS : na
sdS = vvS > 0 ? math.sqrt(math.max(p2S / vvS - vwS * vwS, 0.0)) : na
nyOn = mos >= 930 and mos < 1380
if nyOn
    pvN += tp * volume
    vvN += volume
    p2N += tp * tp * volume
vwN = nyOn and vvN > 0 ? pvN / vvN : na
sdN = nyOn and vvN > 0 ? math.sqrt(math.max(p2N / vvN - vwN * vwN, 0.0)) : na

var bS = array.new<float>(5, na)
var bN = array.new<float>(5, na)
bSprev = array.copy(bS)
bNprev = array.copy(bN)
bS := array.from(vwS, vwS + sdS, vwS + 2 * sdS, vwS - sdS, vwS - 2 * sdS)
bN := array.from(vwN, vwN + sdN, vwN + 2 * sdN, vwN - sdN, vwN - 2 * sdN)

plot(useBookVS ? vwS : na, "Session VWAP", color=color.new(color.blue, 0))
plot(useBookVS ? vwS + sdS : na, "S +1", color=color.new(color.blue, 60))
plot(useBookVS ? vwS - sdS : na, "S -1", color=color.new(color.blue, 60))
plot(useBookVS ? vwS + 2 * sdS : na, "S +2", color=color.new(color.blue, 80))
plot(useBookVS ? vwS - 2 * sdS : na, "S -2", color=color.new(color.blue, 80))
plot(useBookVN ? vwN : na, "NY VWAP", color=color.new(color.purple, 0))
plot(useBookVN ? vwN + sdN : na, "N +1", color=color.new(color.purple, 60))
plot(useBookVN ? vwN - sdN : na, "N -1", color=color.new(color.purple, 60))
plot(useBookVN ? vwN + 2 * sdN : na, "N +2", color=color.new(color.purple, 80))
plot(useBookVN ? vwN - 2 * sdN : na, "N -2", color=color.new(color.purple, 80))

// ----------------------------------------------------------------- signals ----
// a signal = previous close on one side of the level, this close >= depth
// through it. Several levels on one candle: the one nearest the close wins.
sigLevels(array<float> lv, array<float> lvPrev) =>
    int d = 0
    float L = na
    float best = 1e9
    if lv.size() > 0
        for k = 0 to lv.size() - 1
            x  = lv.get(k)
            xp = lvPrev.get(k)
            if na(x) or na(xp)
                continue
            Lk = round025(x)
            int dd = 0
            if close[1] <= xp and close >= x + depthPts
                dd := 1
            else if close[1] >= xp and close <= x - depthPts
                dd := -1
            if dd != 0 and math.abs(close - Lk) < best
                best := math.abs(close - Lk)
                d := dd
                L := Lk
    [d, L]

inWin  = mos <= 1314                       // signal candle must close by 15:55
int d8 = 0
float L8 = na
int dS = 0
float LS = na
int dN = 0
float LN = na
if useBook8 and book8Active and mos >= 60 and inWin
    [a, b] = sigLevels(lv8, lv8)
    d8 := a
    L8 := b
if useBookVS and mos >= 59 and inWin
    [a, b] = sigLevels(bS, bSprev)
    dS := a
    LS := b
if useBookVN and mos >= 944 and inWin
    [a, b] = sigLevels(bN, bNprev)
    dN := a
    LN := b

// ------------------------------------------------------------ book engine ----
var IDS      = array.from("8L", "VS", "VN")
var pendOn   = array.new<bool>(3, false)
var pendArm  = array.new<bool>(3, false)
var pendD    = array.new<int>(3, 0)
var pendL    = array.new<float>(3, na)
var pendStop = array.new<float>(3, na)
var pendRisk = array.new<float>(3, na)
var placed   = array.new<bool>(3, false)   // a real limit order is resting
var posOn    = array.new<bool>(3, false)   // book occupied
var posVirt  = array.new<bool>(3, false)   // occupied by a rail-dropped (virtual) trade
var posD     = array.new<int>(3, 0)
var posE     = array.new<float>(3, na)
var posStop  = array.new<float>(3, na)
var posTgt   = array.new<float>(3, na)

sigD = array.from(d8, dS, dN)
sigL = array.from(L8, LS, LN)

resetBook(int b) =>
    pendOn.set(b, false)
    pendArm.set(b, false)
    placed.set(b, false)
    posOn.set(b, false)
    posVirt.set(b, false)

if newSess
    strategy.close_all(comment="new session safety flat")
    for b = 0 to 2
        strategy.cancel(IDS.get(b))
        resetBook(b)

// G3 rail: same direction within one floor of a position another book holds -> not placed
g3Conflict(int b, int d, float L) =>
    bool r = false
    for c = 0 to 2
        if c != b and posOn.get(c) and not posVirt.get(c) and posD.get(c) == d and math.abs(posE.get(c) - L) <= floorPts
            r := true
    r

for b = 0 to 2
    id = IDS.get(b)
    // --- did a real order fill / a real position close this bar?
    openNow  = isOpenId(id)
    closedNow = closedThisBar(id)
    if placed.get(b) and pendOn.get(b) and (openNow or closedNow)
        // the resting limit filled (and may already have exited within the bar)
        d  = pendD.get(b)
        posOn.set(b, openNow)
        posVirt.set(b, false)
        posD.set(b, d)
        posE.set(b, pendL.get(b))
        posStop.set(b, pendStop.get(b))
        posTgt.set(b, pendL.get(b) + d * tgtR * pendRisk.get(b))
        pendOn.set(b, false)
        pendArm.set(b, false)
        placed.set(b, false)
    else if posOn.get(b) and not posVirt.get(b) and not openNow
        posOn.set(b, false)              // stop or target filled
    // --- virtual (rail-dropped) trade lifecycle: occupies the book, no orders
    if posOn.get(b) and posVirt.get(b)
        d = posD.get(b)
        hitS = d == 1 ? low <= posStop.get(b) : high >= posStop.get(b)
        hitT = d == 1 ? high >= posTgt.get(b) : low <= posTgt.get(b)
        if hitS or hitT
            posOn.set(b, false)
    // --- a new signal in this book
    sd = sigD.get(b)
    sL = sigL.get(b)
    if sd != 0
        if posOn.get(b) and sd != posD.get(b)
            // SAR: opposing crossing close flattens; the opposing signal is worked next
            if not posVirt.get(b)
                strategy.close(id, comment="SAR")
            posOn.set(b, false)
        if not posOn.get(b)
            // the newest signal replaces whatever was resting
            pendOn.set(b, false)
            pendArm.set(b, false)
            if placed.get(b)
                strategy.cancel(id)
                placed.set(b, false)
            st = stopFor(sd, sL)
            rk = math.abs(sL - st)
            if rk <= capPts and not inBlock
                pendOn.set(b, true)
                pendD.set(b, sd)
                pendL.set(b, sL)
                pendStop.set(b, st)
                pendRisk.set(b, rk)
    // --- pending management
    if pendOn.get(b)
        d  = pendD.get(b)
        L  = pendL.get(b)
        rk = pendRisk.get(b)
        st = pendStop.get(b)
        if mos >= 1320 or inBlock
            // pendings die at 16:00; pulled at 08:00 on a news day
            pendOn.set(b, false)
            pendArm.set(b, false)
            if placed.get(b)
                strategy.cancel(id)
                placed.set(b, false)
        else
            if not pendArm.get(b)
                // arming: price must run 1R past the level first (signal candle counts)
                thr = L + d * armR * rk
                if (d == 1 and high >= thr) or (d == -1 and low <= thr)
                    pendArm.set(b, true)
            else if not placed.get(b)
                // armed but withheld by the rail: a touch here is a virtual fill
                touched = d == 1 ? low <= L - TICK : high >= L + TICK
                if touched
                    posOn.set(b, true)
                    posVirt.set(b, true)
                    posD.set(b, d)
                    posE.set(b, L)
                    posStop.set(b, st)
                    posTgt.set(b, L + d * tgtR * rk)
                    pendOn.set(b, false)
                    pendArm.set(b, false)
            if pendOn.get(b) and pendArm.get(b)
                if g3Conflict(b, d, L)
                    if placed.get(b)
                        strategy.cancel(id)
                        placed.set(b, false)
                else
                    // limit lives from the NEXT bar (arming bar strictly before the touch bar)
                    strategy.entry(id, d == 1 ? strategy.long : strategy.short, limit = d == 1 ? L - TICK : L + TICK, comment = id + (d == 1 ? " long " : " short ") + str.tostring(L))
                    strategy.exit("x" + id, from_entry = id, stop = st, limit = L + d * tgtR * rk)
                    placed.set(b, true)

// flat by 17:00: close at 16:58 so the order fills on the 16:59 bar
if mos >= 1378
    strategy.close_all(comment="EOD flat")
    for b = 0 to 2
        strategy.cancel(IDS.get(b))
        resetBook(b)

// ------------------------------------------------------------------ visuals ----
bgcolor(inBlock ? color.new(color.red, 92) : na)
plotshape(d8 == 1 or dS == 1 or dN == 1, "long signal", shape.triangleup, location.belowbar, color.new(color.green, 40), size=size.tiny)
plotshape(d8 == -1 or dS == -1 or dN == -1, "short signal", shape.triangledown, location.abovebar, color.new(color.red, 40), size=size.tiny)
