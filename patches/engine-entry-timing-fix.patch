+    ts = pd.Series(pd.to_datetime([
+        "2026-11-01 18:00", "2026-11-01 20:00", "2026-11-01 23:59",   # Sun evening -> Mon session
+        "2026-11-02 09:30",                                            # Mon cash -> Mon
+        "2026-02-11 09:48",                                            # EST control -> same day
+    ]).tz_localize(NY))
+    for fn in (lambda s: _session_date(s, dtime(18, 0)),
+               lambda s: _anchor_session_date(s, dtime(18, 0))):
