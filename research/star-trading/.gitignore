# Raw caption downloads. Bulky (the 7.5h video alone is 4.5 MB of VTT) and the
# timestamped transcripts carry everything the extraction stage needs.
captions/

# Redundant prose variant — derivable from the timestamped primary.
transcripts/*.plain.txt

# Standalone yt-dlp binary, if dropped next to the scripts.
tools/yt-dlp

# Manifest scratch from an interrupted atomic write.
manifest.json.tmp

# Derived caches for the alpha feasibility test — regenerable from the .zst
# archives in ~19s via tools/alpha_data.py.
tools/_nq_frontmonth.pkl
tools/_alpha_sessions.pkl
tools/_alpha_trades.pkl
__pycache__/
