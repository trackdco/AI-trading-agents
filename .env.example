# Copy to .env and fill in. NEVER commit .env (gitignored).
# code-standards.md: keys live in .env; a .env.example documents required vars.

# Databento — historical (later live) NQ data (architecture.md, External services)
DATABENTO_API_KEY=

# YouTube Data API v3 — the research lane's video sourcing (tools/youtube-mcp/).
# Enables youtube_search / youtube_research_sweep. Transcript fetching works
# WITHOUT this key. Free tier 10,000 units/day; a search costs 100 (~100/day).
# console.cloud.google.com -> enable "YouTube Data API v3" -> API key.
YOUTUBE_API_KEY=
# Optional HTTP proxy for transcript fetches. YouTube blocks datacenter IPs, so
# this is required anywhere but a workstation — including remote Claude Code
# sessions, where www.youtube.com is denied at the egress proxy.
YOUTUBE_TRANSCRIPT_PROXY=

# Telegram — Phase 4 alerting (strategy §11: inbound commands locked to Angus's chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to command the bot (/status /kill).
# To find yours: DM our own bot, then run `python -m src.live.telegram --whoami`.
# (Do NOT use third-party "info" bots — impostor clones of @userinfobot abound.)
# Anyone not listed is silently ignored.
TELEGRAM_ALLOWED_USER_IDS=
