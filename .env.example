# Copy to .env and fill in. NEVER commit .env (gitignored).
# code-standards.md: keys live in .env; a .env.example documents required vars.

# Databento — historical (later live) NQ data (architecture.md, External services)
DATABENTO_API_KEY=

# Telegram — Phase 4 alerting (strategy §11: inbound commands locked to Angus's chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to command the bot (/status /kill).
# To find yours: DM our own bot, then run `python -m src.live.telegram --whoami`.
# (Do NOT use third-party "info" bots — impostor clones of @userinfobot abound.)
# Anyone not listed is silently ignored.
TELEGRAM_ALLOWED_USER_IDS=

# YouTube Data API v3 — the youtube MCP server (scripts/setup_youtube_mcp.sh).
# Console > enable "YouTube Data API v3" > Credentials > API key.
# Read only, nothing to do with the trading path. Free tier is 10,000 units/day
# (search costs 100, most reads cost 1). The setup script reads it from here.
YOUTUBE_API_KEY=
