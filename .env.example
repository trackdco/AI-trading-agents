# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Market data ---------------------------------------------------------
# Databento: historical NQ/GC bars, trades (for CVD) and MBP-10 (for heatmap).
DATABENTO_API_KEY=

# --- Research ------------------------------------------------------------
# YouTube Data API v3. Enables youtube_search / youtube_research_sweep.
# Transcript tools work without it. Free tier = 10,000 units/day ≈ 100 searches.
# https://console.cloud.google.com → enable "YouTube Data API v3" → API key
YOUTUBE_API_KEY=

# Optional: HTTP proxy for transcript fetching. Only needed when the MCP runs
# on a VPS/datacenter IP, which YouTube blocks. Not needed on a laptop.
YOUTUBE_TRANSCRIPT_PROXY=

# Optional: override where transcripts are cached (default research/youtube/).
YOUTUBE_MCP_CACHE_DIR=

# --- Alerting (Phase 4) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
