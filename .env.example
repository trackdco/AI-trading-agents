# Copy to .env and fill in. NEVER commit .env (gitignored).
# code-standards.md: keys live in .env; a .env.example documents required vars.

# Databento — historical (later live) NQ data (architecture.md, External services)
DATABENTO_API_KEY=

# Telegram — Phase 4 alerting (strategy §11: inbound commands locked to Angus's chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to command the bot (/status /kill).
# Get yours from @userinfobot. Anyone not listed is silently ignored.
TELEGRAM_ALLOWED_USER_IDS=
