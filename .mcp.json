{
  "mcpServers": {
    "tradingview": {
      "command": "node",
      "args": ["${TRADINGVIEW_MCP_PATH}/src/server.js"],
      "env": {
        "TV_CDP_PORT": "${TV_CDP_PORT:-9222}"
      }
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${TWENTYFIRST_API_KEY}"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
