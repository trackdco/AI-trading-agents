# data & outputs (code-standards.md: data/raw/ and output/ are gitignored;
# data/reference/ IS committed — it's ground truth)
data/raw/*
!data/raw/.gitkeep
output/*
!output/.gitkeep
# generated validated dataset (Step 2 output) — reproducible from data/raw/ via src/engine/data.py
data/*.parquet
# EXCEPTION: the gold-track 1m bars are committed. They are NOT reproducible — no script
# in this repo builds them and their provenance was never recorded, so the ignore rule
# above meant every gold result died with the container that held them.
!data/gc_1m.parquet
!data/dx_1m.parquet
!data/6j_1m.parquet

# secrets — API keys and tokens live in .env, never committed
.env

# raw news-calendar source PDFs (Forex Factory exports) — the parsed CSV is committed,
# the bulky source PDFs are not. Extract with scripts/extract_news_calendar.py.
data/reference/news_pdfs/

# generated parity artifacts — the agent replay books (scripts/agent_replay.py,
# src/desk/canon_runtime.py), regenerable
agent_replay.parquet
agent_replay_live.parquet

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
output/triggers_hist2326_days/

# Hermes desk rebuild artifacts — recon dumps and full skill-content backups
# (these contain live skill content pulled off the Hermes host)
.hermes-rebuild/
.venv-freeze/

# Dukascopy gold ticks, built by scripts/fetch_gold_ticks.py — reproducible,
# and market data does not belong in git (same rule as data/*.parquet above)
data/gold/
data/transcripts/
