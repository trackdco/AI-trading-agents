# data & outputs (code-standards.md: data/raw/ and output/ are gitignored;
# data/reference/ IS committed — it's ground truth)
data/raw/*
!data/raw/.gitkeep
output/*
!output/.gitkeep

# secrets — API keys and tokens live in .env, never committed
.env

# raw news-calendar source PDFs (Forex Factory exports) — the parsed CSV is committed,
# the bulky source PDFs are not. Extract with scripts/extract_news_calendar.py.
data/reference/news_pdfs/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
